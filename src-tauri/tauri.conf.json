{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toonii",
  "version": "1.1.0",
  "identifier": "com.toonii.desktop",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGRkQyNzcxQjNFOUJBRUQKUldUdHV1bXpjU2Y5cjJnR2R1V1g3ZHV5VHBnUlhvTlN2L3JRbzA5ZzNhcEY4SEU1RnlKa1ZOUG4K",
      "endpoints": ["https://github.com/sudharadev/toonii/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Sudhara Lakshan",
    "copyright": "Copyright © 2026 Sudhara Lakshan",
    "category": "Productivity",
    "shortDescription": "Cartoon sticky notes with googly eyes",
    "longDescription": "Cartoon sticky notes with googly eyes that float on your desktop. Type, draw, tick things off.",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
